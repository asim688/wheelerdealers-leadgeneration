# --- The Wheeler Dealers — example environment variables ---
# Copy this file to ".env" and fill in your values.
# On Vercel, add each of these under Project → Settings → Environment Variables.

# Google Gemini API key (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=""

# Database connection (PostgreSQL).
# - Local dev: docker-compose Postgres (see docker-compose.yml).
# - Production (Vercel is serverless): use a MANAGED, POOLED Postgres URL, e.g.
#   Neon (…-pooler host) or Supabase (port 6543 + ?pgbouncer=true), and append
#   ?sslmode=require. Pooling prevents exhausting DB connections on cold starts.
DATABASE_URL="postgresql://wheeler:wheeler_dev_pw@localhost:5433/wheelerdealers?schema=public"

# Optional: a DIRECT (non-pooled) connection used only for schema migrations
# (prisma migrate deploy / db push). Set this to the direct URL when your
# DATABASE_URL points at a pooler. Safe to leave unset locally.
# DIRECT_URL=""

# Display currency (ISO 4217): USD, GBP, EUR, AED, etc.
NEXT_PUBLIC_CURRENCY="AED"

# VIN decoder (Vincario) — https://vindecoder.eu/
VINCARIO_API_KEY=""
VINCARIO_SECRET_KEY=""

# Secret used to sign dealer login sessions (use: openssl rand -base64 32)
AUTH_SECRET="change-me"

# Admin (platform operator) credentials for the /admin console
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin1234"

# Secret (Bearer token) for the scheduled market-data refresh job.
# Vercel Cron automatically sends "Authorization: Bearer $CRON_SECRET" when this
# is set. Market prices are cached and only re-fetched when older than ~3 months.
CRON_SECRET="change-me"

# --- Vehicle Inspection module ---------------------------------------------
# Public base URL used to build customer report links (no trailing slash).
# On Vercel this is auto-detected; set it explicitly for custom domains.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Flat inspection fee (in NEXT_PUBLIC_CURRENCY). Defaults to 10.
INSPECTION_FEE_AED="10"

# Google Maps API key (client-side) — enables address autocomplete in the
# inspection booking chat. Without it, the address field falls back to manual
# entry. Restrict the key to your domain + the Maps JavaScript & Places APIs.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Photo storage — connect Vercel Blob to your project and this is auto-added.
# Without it, inspection photo upload is disabled (returns a clear message).
# BLOB_READ_WRITE_TOKEN=""

# Email notifications (Resend — https://resend.com). Without a key, emails are
# logged only. RESEND_FROM must be a verified sender/domain.
# RESEND_API_KEY=""
# RESEND_FROM="The Wheeler Dealers <noreply@yourdomain.com>"

# SMS / WhatsApp notifications (Twilio). Without these, messages are logged only.
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_SMS_FROM="+1234567890"
# TWILIO_WHATSAPP_FROM="+14155238886"

# Customer phone login via Firebase Phone Auth (UAE numbers only). Public web
# config from Firebase console > Project settings > Your apps. When all four are
# set the OTP popup uses Firebase; otherwise it uses the server-side OTP flow.
# NEXT_PUBLIC_FIREBASE_API_KEY=""
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
# NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project"
# NEXT_PUBLIC_FIREBASE_APP_ID=""
