// Prisma schema — The Wheeler Dealers
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // PostgreSQL for both local (via docker-compose) and production. Set
  // DATABASE_URL in the environment. See docker-compose.yml for local dev.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A captured lead from the AI search flows (Sell / Trade / Buy / Dealer).
model Lead {
  id     String @id @default(cuid())
  intent String @default("sell") // sell | buy | trade | dealer

  // Vehicle details (collected by the AI)
  make      String?
  model     String?
  trim      String?
  year      Int?
  mileage   Int?
  condition String?
  vin       String? // chassis number, read from the Mulkiya
  engineNo  String? // engine number, read from the Mulkiya

  // Extended vehicle questionnaire (Sell flow)
  accident       String? // No accident | Minor accident | Major accident | Structural damage | Not sure
  serviceHistory String? // Agency | Authorized garage | Local garage | Self-maintained | No records
  previousOwners Int?
  warranty       String? // Yes | No
  keys           String? // Two keys | One key | No keys
  modifications  String? // Yes | No

  // Uploaded inspection report (AI-analysed before pricing)
  hasInspectionReport     Boolean @default(false)
  inspectionReportScore   Float? // overall rating 0-10
  inspectionReportSource  String? // provider name (e.g. dubizzle) or generic
  inspectionReportSummary String? // one-line AI condition summary

  // Contact details
  name   String?
  mobile String?
  email  String?

  // AI valuation result
  estimateMin Int?
  estimateMax Int?
  currency    String?

  // Free-inspection booking (Sell journey steps 9-10)
  inspectionType String? // home | branch | expert-chat
  inspectionSlot String? // Today | Tomorrow | This Weekend | <custom date>
  inspectionAt   DateTime? // when the booking was made

  createdAt DateTime @default(now())

  // A sell/trade lead may be offered to dealers via an auction.
  auction Auction?

  @@index([intent])
  @@index([createdAt])
}

/// A car in the dealer inventory, matched against buyers in the Buy/Trade flows.
model Car {
  id           String  @id @default(cuid())
  make         String
  model        String
  year         Int
  price        Int
  mileage      Int
  bodyType     String // sedan | suv | hatchback | coupe | truck | van | convertible | wagon
  fuelType     String // petrol | diesel | hybrid | electric
  transmission String // automatic | manual
  color        String?
  seats        Int?
  description  String?
  imageUrl     String?
  sold         Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([make])
  @@index([bodyType])
  @@index([price])
  @@index([sold])
}

/// A registered car dealer who can bid on seller leads in the Dealer Core auction.
model Dealer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  approved     Boolean  @default(false)
  createdAt    DateTime @default(now())

  bids Bid[]
}

/// An auction listing a seller's lead to dealers. Dealers bid; the platform
/// takes the winning offer back to the seller to finalise.
model Auction {
  id           String    @id @default(cuid())
  leadId       String    @unique
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status       String    @default("open") // open | closed
  endsAt       DateTime?
  winningBidId String?
  createdAt    DateTime  @default(now())

  bids Bid[]

  @@index([status])
}

/// A single dealer bid on an auction.
model Bid {
  id        String   @id @default(cuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  dealerId  String
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  amount    Int
  createdAt DateTime @default(now())

  @@index([auctionId])
  @@index([dealerId])
}

/// Cached market price data for a make/model/year, aggregated from external
/// classified platforms. Refreshed at most once per ~3 months (see
/// src/lib/marketData.ts) so we never re-fetch on every valuation request.
model MarketPrice {
  id    String @id @default(cuid())
  make  String
  model String
  year  Int

  // Aggregated statistics from the sampled listings (display currency).
  sampleCount Int    @default(0)
  avgPrice    Int
  minPrice    Int
  maxPrice    Int
  currency    String

  source    String   @default("aggregate") // where the samples came from
  fetchedAt DateTime @default(now()) // last refresh timestamp

  // One cached row per vehicle key.
  @@unique([make, model, year])
  @@index([fetchedAt])
}

/// A single raw car-for-sale listing scraped from the UAE classifieds
/// (Dubizzle / BuyAnyCar / YallaMotor). This is the full dataset the Sell-flow
/// valuation searches against after a VIN is decoded. Aggregated into
/// MarketPrice for fast make/model/year lookups.
model CarListing {
  id           String  @id @default(cuid())
  title        String?
  make         String
  model        String?
  trim         String?
  year         Int
  mileageKm    Int?
  specs        String?
  transmission String?
  priceAed     Int
  location     String?
  dealer       String?
  source       String  @default("aggregate") // dubizzle | buyanycar | yallamotor

  createdAt DateTime @default(now())

  @@index([make])
  @@index([make, model])
  @@index([make, model, year])
  @@index([priceAed])
}

// ---------------------------------------------------------------------------
// VEHICLE INSPECTION MODULE
// ---------------------------------------------------------------------------

/// A third-party inspection company registered on the marketplace. Companies
/// self-register, are approved by admin, then compete to accept available
/// inspection jobs (first-accept-wins). Kept under the historical "Inspector"
/// name to avoid a disruptive rename across the codebase.
/// An inspection company (the "parent" tenant). Registers on the platform,
/// is approved by Super Admin, accepts live jobs and assigns them to its own
/// inspectors ("children"). Company admin logs in with email + password.
model InspectionCompany {
  id           String   @id @default(cuid())
  name         String // company display name
  details      String? // free-text company description
  email        String   @unique
  passwordHash String
  phone        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Location (registration: current location or picked on a map)
  address String?
  city    String?
  emirate String?
  lat     Float?
  lng     Float?

  // Point of Contact — the person we call/WhatsApp when a job goes live
  pocName   String?
  pocMobile String?
  pocEmail  String?

  // Ownership checks (6-digit code by email / SMS). Registration cannot
  // complete without all four; accounts that pre-date the check were
  // backfilled as verified.
  emailVerifiedAt     DateTime?
  phoneVerifiedAt     DateTime?
  pocEmailVerifiedAt  DateTime?
  pocMobileVerifiedAt DateTime?

  // Business profile
  tradeLicense String?
  areas        String? // comma-separated emirates/cities covered
  services     String? // comma-separated inspection services offered

  // Payout / banking details used to settle earned commissions
  bankAccountTitle  String?
  bankAccountNumber String?
  bankIban          String?
  bankName          String?
  bankBranch        String?

  // Admin approval workflow: pending | approved | suspended
  approvalStatus String @default("pending")

  /// Partner type chosen at registration: inspection (vehicle inspections) | care (towing & roadside).
  /// Only "inspection" partners receive / accept inspection jobs.
  partnerType  String  @default("inspection")
  /// Care partners: comma-separated services (scheduled_tow,emergency_tow,jump_start,fuel_delivery)
  careServices String?
  /// Care partners: comma-separated emirates covered; empty = all emirates
  careEmirates String?

  // Wheeler Dealers staff member who verifies this company's reports.
  accountManagerId String?
  accountManager   AccountManager? @relation(fields: [accountManagerId], references: [id], onDelete: SetNull)

  // Who verified (approved) this company's registration, and when — kept for the track record.
  verifiedAt      DateTime?
  verifiedByName  String?
  verifiedByEmail String?
  verifiedByRole  String?

  inspectors   Inspector[]
  jobs         InspectionJob[]       @relation("CompanyJobs")
  documents    CompanyDocument[]
  activity     CompanyActivity[]
  agreements   CommissionAgreement[]
  careBids     CareBid[]
  careAssigned CareRequest[]         @relation("CareAssignedPartner")

  @@index([approvalStatus])
  @@index([accountManagerId])
}

/// Track record of every registration / status decision on an inspection company
/// (registered, approved, suspended, reinstated, activated, deactivated) with the
/// staff member who made it.
model CompanyActivity {
  id         String            @id @default(cuid())
  companyId  String
  company    InspectionCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  action     String // registered | approved | suspended | reinstated | activated | deactivated | pending
  actorName  String?
  actorEmail String?
  actorRole  String? // super_admin | account_manager | company
  ip         String?
  userAgent  String?
  note       String?
  createdAt  DateTime          @default(now())

  @@index([companyId, createdAt])
}

/// Registration documents (trade licence, VAT certificate, extras). Stored in the
/// DB, not public blob storage, and only served to admin through an authenticated route.
model CompanyDocument {
  id        String            @id @default(cuid())
  companyId String
  company   InspectionCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind      String // trade_license | vat_certificate | iban_letter | other
  label     String? // free-text title for kind=other
  fileName  String
  mimeType  String
  sizeBytes Int
  data      Bytes
  createdAt DateTime          @default(now())

  @@index([companyId])
}

model Inspector {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Verified by the inspector at first sign-in; job APIs stay locked until both are set.
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?

  // Parent company (multi-tenant). Legacy standalone accounts have null.
  companyId String?
  company   InspectionCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  // Legacy company-profile fields (kept for pre-multi-tenant rows)
  contactPerson String?
  tradeLicense  String?
  areas         String? // comma-separated emirates/cities covered
  services      String? // comma-separated inspection services offered
  bankName      String?
  bankIban      String?

  // Admin approval workflow: pending | approved | suspended
  approvalStatus String @default("approved")

  jobs InspectionJob[]

  @@index([approvalStatus])
  @@index([companyId])
}

/// A customer account. Login is required before booking (mobile OTP).
model Customer {
  id              String    @id @default(cuid())
  mobile          String    @unique // verified by the OTP login itself
  name            String?
  email           String? // only ever set through email verification
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  lastLogin       DateTime?

  jobs         InspectionJob[]
  careRequests CareRequest[]
  careOrders   CareOrder[]
}

/// One-time passwords for customer mobile login. Verified codes are deleted;
/// expired ones ignored.
model OtpCode {
  id        String   @id @default(cuid())
  mobile    String
  codeHash  String // scrypt hash of the 6-digit code
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([mobile])
  @@index([expiresAt])
}

/// Simple key-value store for admin-configurable platform settings
/// (e.g. inspection customer price, partner payout amount).
/// Wheeler Dealers staff member ("Account Manager") who verifies the reports
/// of the inspection companies the super admin assigns to them.
model AccountManager {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  phone           String?
  passwordHash    String
  active          Boolean   @default(true)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  createdAt       DateTime  @default(now())

  companies InspectionCompany[]
}

/// Audit trail of the report review: submissions, reviewer edits, returns to
/// the inspector and approvals (who did what, when).
model ReportActivity {
  id        String        @id @default(cuid())
  jobId     String
  job       InspectionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  action    String // submitted | edited | returned | approved
  detail    String? // human-readable summary (e.g. field changes, return note)
  actorType String // inspector | manager | admin
  actorId   String?
  actorName String?
  createdAt DateTime      @default(now())

  @@index([jobId, createdAt])
}

/// One-time codes proving ownership of an email address or UAE mobile
/// (company, Point of Contact, inspector, customer email). SMS codes sent via
/// Message Central keep "mc:<verificationId>" in codeHash.
model VerificationCode {
  id        String   @id @default(cuid())
  channel   String // sms | email
  target    String // +9715XXXXXXXX or lower-cased email
  codeHash  String // "salt:scrypt" or "mc:<verificationId>"
  ip        String?
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([channel, target, createdAt])
  @@index([ip, createdAt])
  @@index([expiresAt])
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// A customer-booked vehicle inspection job. Created by the public booking
/// wizard, assigned to an inspector by admin, then carried out and reported.
model InspectionJob {
  id      String @id @default(cuid())
  jobCode String @unique // human-friendly, e.g. WD-260722-0015
  // Marketplace lifecycle:
  // payment_pending → available → accepted → in_progress → report_submitted → completed
  // (cancelled possible at any point; legacy values open/assigned map to available/accepted)
  status  String @default("payment_pending")

  // Public, unguessable token for the customer-facing report link.
  reportToken String? @unique

  // Customer (step 1)
  customerName   String
  customerMobile String
  customerEmail  String

  // Vehicle (step 2 — VIN decode)
  vin          String?
  make         String?
  model        String?
  year         Int?
  bodyClass    String?
  trim         String?
  transmission String?
  fuelType     String?

  // Location (step 3)
  address String?
  city    String?
  emirate String?
  lat     Float?
  lng     Float?

  // Schedule (step 4)
  scheduledAt   DateTime?
  scheduledSlot String? // e.g. "10:00 AM"

  // Commercial
  fee      Int?
  currency String @default("AED")

  // Online payment (provider-ready Stripe; auto-paid when no keys configured)
  paymentStatus   String    @default("pending") // pending | paid | waived
  paymentProvider String? // stripe | dev-auto | manual
  paymentRef      String? // e.g. Stripe checkout session id
  paidAt          DateTime?

  // Partner economics — snapshotted at acceptance so later admin pricing
  // changes don't rewrite historical earnings. Commission = fee - partnerPayout.
  partnerPayout Int?

  // Customer account that booked this job (OTP login). Legacy jobs null.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Marketplace dispatch (Uber-style): the company that accepted the job,
  // companies banned from re-accepting after cancelling, and the live-window
  // expiry after which the job is no longer offered.
  acceptedByCompanyId String?
  acceptedByCompany   InspectionCompany? @relation("CompanyJobs", fields: [acceptedByCompanyId], references: [id], onDelete: SetNull)
  excludedCompanyIds  String? // comma-separated company ids that cancelled this job
  expiresAt           DateTime?

  // Assignment (marketplace accept, or admin override) + lifecycle
  assignedInspectorId String?
  inspector           Inspector? @relation(fields: [assignedInspectorId], references: [id], onDelete: SetNull)
  assignedAt          DateTime?
  acceptedAt          DateTime?
  startedAt           DateTime?
  reportSubmittedAt   DateTime?
  completedAt         DateTime?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    InspectionItem[]
  photos   InspectionPhoto[]
  report   InspectionReport?
  activity ReportActivity[]
  payment  JobPayment?
  invoice  TaxInvoice?

  @@index([status])
  @@index([assignedInspectorId])
  @@index([acceptedByCompanyId])
  @@index([customerId])
  @@index([scheduledAt])
  @@index([createdAt])
}

/// A single inspection point within a job (e.g. "Front bumper" under Exterior).
/// Materialised from the checklist template when the inspector starts the job,
/// so every point has a stable unique id for answers and photos.
model InspectionItem {
  id        String        @id @default(cuid())
  jobId     String
  job       InspectionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  section   String // e.g. "Tyres"
  itemKey   String // stable key from the template (e.g. "tyres.fl")
  label     String // human label
  // Neutral observation chosen by the inspector, e.g. "No obvious issue
  // observed" | "Wear or damage observed" | "Not assessed / unavailable"
  // (paint panels: Original paint | Repainted | Panel replaced). Jobs from
  // before Oct 2026 hold the legacy Good | Fair | Poor | Fail | N/A ratings.
  condition String?
  comments  String?
  // Structured measurements, e.g. { dotWeek, dotYear, treadMm } for tyres or
  // { thicknessUm } for body panels.
  value     Json?
  order     Int           @default(0)

  photos InspectionPhoto[]

  @@unique([jobId, itemKey])
  @@index([jobId])
}

/// A photo attached to a job (optionally to a specific inspection item).
model InspectionPhoto {
  id        String          @id @default(cuid())
  jobId     String
  job       InspectionJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  itemId    String?
  item      InspectionItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  url       String
  caption   String?
  createdAt DateTime        @default(now())

  @@index([jobId])
  @@index([itemId])
}

/// The generated report for a completed inspection.
model InspectionReport {
  id              String        @id @default(cuid())
  jobId           String        @unique
  job             InspectionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  // Section 12 — diagnostic scan and inspector comments (facts only).
  summary         String? // additional observations
  diagnosticScan  String? // diagnostic scan history / fault codes found
  limitations     String? // components not checked / not accessible and why
  // Legacy (pre Oct 2026). The report no longer scores, grades or recommends;
  // these stay nullable so historic rows still load.
  recommendations String?
  overallScore    Float?
  verdict         String?
  // Section 01 — recorded at inspection time (vehicle identification table)
  odometerKm      Int?
  odometerStatus  String? // odometer authenticity wording, e.g. "No indication of alteration observed"
  exteriorColor   String?
  regionalSpecs   String? // GCC | American | Japanese | European | Korean | Other
  engineConfig    String? // e.g. "4-cylinder"
  keysCount       Int?
  spareTyre       String? // Available | Not available | Repair kit
  // Wheeler Dealers verification (account manager / super admin) before the
  // report is released to the customer with the red verification stamp.
  verifiedAt      DateTime?
  verifiedById    String? // AccountManager id, or "admin"
  verifiedByName  String?
  returnedAt      DateTime? // set while the report is back with the inspector
  returnNote      String?
  generatedAt     DateTime      @default(now())
  sentAt          DateTime?
}

// ── Payment Management (Phase 1) ─────────────────────────────────────────────
// All money below is stored as integer fils (1 AED = 100 fils); never floats.

/// A company's commission agreement. Every change is a new row (the previous
/// active row becomes "superseded"), so the table itself is the change history.
model CommissionAgreement {
  id            String            @id @default(cuid())
  companyId     String
  company       InspectionCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type          String // percentage | fixed
  /// percentage → basis points (1500 = 15.00%); fixed → fils (5000 = AED 50.00)
  value         Int
  status        String            @default("active") // active | superseded
  previousType  String?
  previousValue Int?
  note          String?
  createdById   String?
  createdByName String?
  createdByRole String? // admin | account_manager
  createdAt     DateTime          @default(now())

  @@index([companyId, createdAt])
}

/// One row per paid inspection job: the money split and the partner payout state.
/// The commission fields are an immutable snapshot taken when a company accepts.
model JobPayment {
  id        String        @id @default(cuid())
  jobId     String        @unique
  job       InspectionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  companyId String?
  currency  String        @default("AED")

  grossFils Int // what the customer paid, VAT included
  vatFils   Int // 5% VAT contained in the gross amount
  netFils   Int // gross - VAT

  agreementId     String?
  commissionType  String? // snapshot: percentage | fixed
  commissionValue Int? // snapshot: bp or fils
  commissionFils  Int? // WD commission (excl. VAT)
  partnerFils     Int? // paid to the inspection company
  snapshotAt      DateTime?

  paymentStatus String @default("received") // received | refund_requested | partially_refunded | refunded
  refundedFils  Int    @default(0)

  // not_eligible → pending → (due, derived once eligibleAt passes) → paid; on_hold by Admin
  payoutStatus String    @default("not_eligible")
  eligibleAt   DateTime? // report delivered + 3 hours
  paidAt       DateTime?
  payoutRef    String? // bank transfer reference
  paidByName   String?
  holdReason   String?
  heldByName   String?
  heldAt       DateTime?

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  events    PaymentEvent[]

  @@index([companyId, payoutStatus])
  @@index([payoutStatus, eligibleAt])
}

/// Immutable audit trail of everything that happens to a payment.
model PaymentEvent {
  id        String     @id @default(cuid())
  paymentId String
  payment   JobPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  type      String // created | snapshot | eligible | hold | release | paid | refund_requested | refund
  actorName String?
  actorRole String? // admin | account_manager | system | customer
  detail    String?
  createdAt DateTime   @default(now())

  @@index([paymentId, createdAt])
}

/// Staff login for the Super Admin side (created by an Admin).
model AdminUser {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  active        Boolean   @default(true)
  createdByName String?
  createdAt     DateTime  @default(now())
  lastLoginAt   DateTime?
}

/// Refund of a customer payment. Admin only; full = the amount collected, or a manual partial amount.
model PaymentRefund {
  id              String    @id @default(cuid())
  paymentId       String
  amountFils      Int
  kind            String // full | partial
  reason          String?
  status          String    @default("requested") // requested | done | rejected
  reference       String? // Stripe refund id / note
  requestedBy     String? // customer | admin name
  processedByName String?
  createdAt       DateTime  @default(now())
  processedAt     DateTime?

  @@index([paymentId])
}

/// UAE tax invoice issued to the customer when their payment is received.
/// The invoice number is derived from `seq` (gapless per successful insert).
model TaxInvoice {
  id    String        @id @default(cuid())
  seq   Int           @unique @default(autoincrement())
  token String        @unique @default(cuid()) // unguessable public download link
  jobId String        @unique
  job   InspectionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  issuedAt      DateTime  @default(now())
  supplyDate    DateTime // date the payment was received / service supplied
  customerName  String
  customerEmail String
  description   String
  currency      String    @default("AED")
  grossFils     Int
  vatFils       Int
  netFils       Int
  emailedAt     DateTime?
  createdAt     DateTime  @default(now())
}

// ─── Care module ─────────────────────────────────────────────────────────────
// Roadside assistance (WD-managed dispatch), scheduled towing (reverse bidding)
// and a priced car-care catalogue. Money is stored in fils (AED x 100).

/// A customer request: roadside (WD assigns a partner) or scheduled tow (partners bid).
model CareRequest {
  id      String @id @default(cuid())
  code    String @unique // e.g. WD-CARE-261120-0001
  kind    String // roadside | towing
  service String // jump_start | emergency_tow | fuel_delivery | scheduled_tow
  /// roadside: submitted → reviewing → assigned → en_route → completed | cancelled
  /// towing:   open → offer_accepted → confirmed → in_progress → completed | cancelled
  status  String

  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName   String
  customerMobile String
  customerEmail  String?

  make      String?
  model     String?
  year      Int?
  condition String? // runs | not_starting | accident | flat_tyre | other
  issue     String? // short problem description / safety notes

  pickupAddress String
  pickupEmirate String?
  pickupLat     Float?
  pickupLng     Float?
  destAddress   String?
  destEmirate   String?
  destLat       Float?
  destLng       Float?

  fuelType   String? // petrol_special | petrol_super | diesel
  fuelLitres Int?

  scheduledAt DateTime?
  flexible    Boolean   @default(false)
  bidsCloseAt DateTime?

  /// Roadside: partner + quote set by WD. Towing: copied from the accepted bid.
  assignedPartnerId String?
  assignedPartner   InspectionCompany? @relation("CareAssignedPartner", fields: [assignedPartnerId], references: [id], onDelete: SetNull)
  priceFils         Int?
  etaMinutes        Int?
  acceptedBidId     String?
  /// Partner reconfirmed a different ETA after award; customer must approve before confirmation.
  etaChangePending  Boolean            @default(false)

  /// Roadside: pay_on_site → collected_on_site. Towing (paid online when the customer accepts a bid):
  /// none → pending → paid. Refunds are tracked separately below so a later payment never hides one.
  paymentStatus   String    @default("none")
  paymentProvider String? // stripe | tamara | dev-auto | on_site
  paymentRef      String?
  paidFils        Int?
  paidAt          DateTime?
  pendingBidId    String? // bid the customer is paying for right now
  pendingSince    DateTime?
  /// none | due | refunded — money WD owes back to the customer on this request (any earlier payments)
  refundStatus    String    @default("none")
  refundFils      Int       @default(0)
  refundRef       String?

  adminNote    String?
  cancelReason String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bids   CareBid[]
  events CareEvent[]

  @@index([kind, status, createdAt])
  @@index([customerId, createdAt])
}

/// A partner's offer on a scheduled-tow request. Price is VAT-inclusive; ETA = minutes to reach pickup.
model CareBid {
  id                  String            @id @default(cuid())
  requestId           String
  request             CareRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  partnerId           String
  partner             InspectionCompany @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  priceFils           Int
  etaMinutes          Int
  pickupAt            DateTime?
  terms               String?
  status              String            @default("active") // active | withdrawn | accepted | rejected
  confirmedEtaMinutes Int?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([requestId, partnerId])
  @@index([partnerId, status])
}

/// Immutable history of a care request.
model CareEvent {
  id        String      @id @default(cuid())
  requestId String
  request   CareRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  type      String
  actorName String?
  actorRole String? // customer | admin | partner | system
  detail    String?
  createdAt DateTime    @default(now())

  @@index([requestId, createdAt])
}

/// Car batteries, oil & filters and accessories with VAT-inclusive prices.
model CareProduct {
  id            String   @id @default(cuid())
  category      String // battery | oil | accessory
  name          String
  brand         String?
  description   String?
  imageUrl      String?
  priceFils     Int // VAT inclusive
  installFils   Int? // optional installation charge (VAT inclusive)
  deliveryFils  Int? // optional delivery charge (VAT inclusive)
  /// One rule per line: "Toyota Corolla 2015-2022", "Nissan", "Honda Civic". Empty = fits all vehicles.
  compatibility String?
  inStock       Boolean  @default(true)
  active        Boolean  @default(true)
  sample        Boolean  @default(false) // demo catalogue item
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category, active])
}

/// A product order placed from the Care catalogue.
model CareOrder {
  id             String    @id @default(cuid())
  code           String    @unique // e.g. WD-ORD-261120-0001
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName   String
  customerMobile String
  customerEmail  String?
  /// [{ productId, name, brand, qty, unitFils, installFils }]
  items          Json
  fulfilment     String // delivery | installation
  address        String
  emirate        String?
  vehicle        String?
  subtotalFils   Int
  chargesFils    Int
  totalFils      Int // VAT inclusive
  status         String    @default("placed") // placed | confirmed | out_for_delivery | completed | cancelled
  adminNote      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, createdAt])
}

/// Shared login rate-limit counters (fixed window), so limits hold across all
/// serverless instances. Keys look like "login-ip:<name>:<ip>" or "login-acct:<email>".
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}
